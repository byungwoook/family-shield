# Copy to .env and fill in your own values. Never commit .env.

# Lead
ANTHROPIC_API_KEY=
GUARDIAN_SEED=
VOICE_ANALYST_SEED=
FAMILY_SEED=
VERIFIER_SEED=
VOICE_ANALYST_ADDRESS=      # agent1q... printed when the Voice Analyst starts
FAMILY_ADDRESS=             # agent1q... printed when the Family agent starts
VERIFIER_ADDRESS=           # agent1q... printed when the Verifier starts
GUARDIAN_ADDRESS=           # optional: Family and Verifier work it out from GUARDIAN_SEED if this is blank
SCAM_INTEL_SEED=
SCAM_INTEL_ADDRESS=         # agent1q... printed when the Scam Intel agent starts
APIFY_TOKEN=                # apify.com -> Settings -> API & Integrations (for: python -m services.scam_intel seed)
CODE_TIMEOUT_SECONDS=180
REPLY_WAIT_SECONDS=0         # keep 0: ASI:One drops replies that arrive late
USE_CARDS=true              # false = plain text replies, no ASI:One cards
DEMO_STUDENT_PHONE=         # the phone that gets the verification call, e.g. +14155550123

# Teammate A
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # optional, a voice from https://play.cartesia.ai/voices
CARTESIA_AGENT_ID=          # printed by: python -m services.cartesia_setup
CARTESIA_FROM_NUMBER_ID=    # printed by: python -m services.cartesia_setup
CODE_WEBHOOK_URL=           # public https base that reaches services/code_webhook.py (e.g. cloudflared tunnel)
CODE_WEBHOOK_SECRET=        # any long random string; Cartesia sends it as a Bearer token
CODE_WEBHOOK_PORT=8090
# Product check codes (backend/codes.py). That module reads this; the hackathon agents do not.
# A long random string. Not a 4-digit or 6-digit code, and never written to the database.
CODE_PEPPER=
# Derives the 6-digit one-time call code (backend/codes.py). Separate from CODE_PEPPER.
# A long random string. Not a 6-digit code, and never written to the database.
OTP_DERIVATION_KEY=
# Product Postgres (backend/store.py). Placeholder only.
# Local tests use docker-compose.yml: docker compose up -d
DATABASE_URL=
# Product API (backend/api.py). Leave both blank in production.
# The process refuses to boot when ENV=production and DEV_AUTH=1.
# DEV_AUTH=1 is the dev login used by tests. It is not a secret.
ENV=
DEV_AUTH=
# Milestone 5 sign-in (backend/signin.py). Required unless DEV_AUTH=1.
APPLE_BUNDLE_ID=            # the iOS app's bundle id, the aud of its Apple identity token
GOOGLE_SERVER_CLIENT_ID=    # the OAuth client id the Android app requests its Google ID token for
# Milestone 5 SMS OTP (backend/enroll.py). Required unless DEV_AUTH=1, which logs codes instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # an SMS-capable number for +1 and +82, or leave blank and set the next line
TWILIO_MESSAGING_SERVICE_SID=
# Milestone 6 fallback call (backend/calls.py). TWILIO_FROM_NUMBER must also be voice-capable for +1 and +82.
PUBLIC_BASE_URL=            # the https origin Twilio reaches, e.g. https://api.example.com (webhook signatures use it)
PROMPTS_DIR=                # optional; default backend/prompts. Production refuses to boot if the 12 mp3s are missing
CARTESIA_VOICE_ID_KO=       # a Korean Sonic voice for: python -m scripts.render_prompts
# Milestone 8 push (backend/push.py). Both optional: without them an app child is
# reached by the call after the 90-second window. Key files stay outside the repo.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=              # path to the AuthKey_XXXX.p8 file
APNS_TOPIC=                 # the iOS bundle id
FCM_SERVICE_ACCOUNT_FILE=   # path to the Firebase service-account JSON
TIMER_SECONDS=5             # how often deadlines are checked; 0 turns the loop off
# Milestone 7 analysis (backend/analysis.py) reuses ANTHROPIC_API_KEY, CLAUDE_MODEL, and
# CARTESIA_API_KEY from above. Blank keys skip that step; the case still opens and calls.

# Teammate B
SUPABASE_URL=
SUPABASE_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Optional (defaults shown)
# CLAUDE_MODEL=claude-sonnet-5-5
# APIFY_ACTOR=apify~google-search-scraper
# MOSS_INDEX=family-directory
# SCAM_INDEX=scam-patterns
# MOSS_CACHE=.moss-cache
