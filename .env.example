# Copy to .env and fill in your own values. Never commit .env.

# Claims and the pattern id (backend/analysis.py). Blank: that step is skipped
# and the case still opens. The model does not decide green or red.
ANTHROPIC_API_KEY=
# Optional. Default claude-sonnet-5-5.
# CLAUDE_MODEL=claude-sonnet-5-5

# Speech-to-text and the twelve prompt files (services/cartesia_tools.py).
# Blank CARTESIA_API_KEY skips voice-note transcription. The verification call
# plays the files already in backend/prompts/ and does not call Cartesia.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # optional English voice; default is Whitney
CARTESIA_VOICE_ID_KO=       # a Korean Sonic voice for: python -m scripts.render_prompts

# Product check codes (backend/codes.py). A long random string each.
# Not a 4-digit or 6-digit code, and never written to the database.
CODE_PEPPER=
OTP_DERIVATION_KEY=

# Product Postgres (backend/store.py). Placeholder only.
# Local tests use docker-compose.yml: docker compose up -d
DATABASE_URL=

# Product API (backend/api.py). Leave both blank in production.
# The process refuses to boot when ENV=production and DEV_AUTH=1.
# DEV_AUTH=1 is the dev login used by tests. It is not a secret.
ENV=
DEV_AUTH=

# Sign-in (backend/signin.py). Required unless DEV_AUTH=1.
APPLE_BUNDLE_ID=            # the iOS app's bundle id, the aud of its Apple identity token
GOOGLE_SERVER_CLIENT_ID=    # the OAuth client id the Android app requests its Google ID token for

# SMS OTP and the verification call (backend/enroll.py, backend/calls.py).
# Required unless DEV_AUTH=1, which logs codes and records calls instead of dialing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # voice-capable for +1 and +82, or leave blank and set the next line for SMS only
                            # The apps label this same number as "Family Shield" (milestone 17).
                            # Until a build sets it, they label the placeholder +15555550100, not a real number.
TWILIO_MESSAGING_SERVICE_SID=
PUBLIC_BASE_URL=            # the https origin Twilio reaches, e.g. https://api.example.com (webhook signatures use it)
PROMPTS_DIR=                # optional; default backend/prompts. Production refuses to boot if the 12 mp3s are missing

# Push (backend/push.py). Optional: without them an app child is reached by
# the call after the 90-second window. Key files stay outside the repo.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=              # path to the AuthKey_XXXX.p8 file
APNS_TOPIC=                 # the iOS bundle id
FCM_SERVICE_ACCOUNT_FILE=   # path to the Firebase service-account JSON
TIMER_SECONDS=5             # how often deadlines are checked; 0 turns the loop off

# The old keypad webhook (services/code_webhook.py). Not the product call.
# The product does not read this. python -m services.code_webhook does.
CODE_WEBHOOK_SECRET=
CODE_WEBHOOK_PORT=8090
